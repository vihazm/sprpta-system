# Copy this file to .env and adjust. .env is ignored by git; never commit real secrets.

APP_ENV=development            # development | production

# PostgreSQL connection (SQLAlchemy URL, psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sprpta_db

# Secret used to sign access tokens. At least 32 characters; the app refuses to
# start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional overrides (defaults shown). Time targets are proposals, not client values.
# ACCESS_TOKEN_MINUTES=15
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15

# Production only: the first administrator, used by `python -m app.scripts.seed`
# ADMIN_LOGIN=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=System Administrator
