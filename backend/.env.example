# Copy this file to .env and adjust. .env is ignored by git; never commit real secrets.

APP_ENV=development            # development | production

# PostgreSQL connection (SQLAlchemy URL, psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sprpta_db

# Secret used to sign access tokens. At least 32 characters; the app refuses to
# start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional overrides (defaults shown). Time targets are proposals, not client values.
# ACCESS_TOKEN_MINUTES=15
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15

# Email for sign-up codes. Fill these in to send real emails; leave SMTP_HOST empty and the code is printed in the
# backend terminal instead (development only). Gmail: turn on 2-step verification, create an "App password" at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD (never your normal Google password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=SPRPTA <yourname@gmail.com>
# SMTP_SSL=false                # true only for port 465

# Daily backups (python -m app.scripts.backup). Relative folders are inside backend/.
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# PG_DUMP_PATH=pg_dump          # the full path if it is not on PATH, e.g. C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# Production only: the first administrator, used by `python -m app.scripts.seed`
# ADMIN_LOGIN=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=System Administrator

# Optional: use a different password than the public demo one for a seeded account (development only).
# Name = the login before the @ in capitals, e.g. for shamila_ad_matara@sprpta.test:
# SEED_PASSWORD_SHAMILA_AD_MATARA=
